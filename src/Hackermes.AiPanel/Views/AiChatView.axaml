<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hackermes.AiPanel.ViewModels"
             x:Class="Hackermes.AiPanel.Views.AiChatView"
             x:DataType="vm:AiChatViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="12">
    <!-- Header: session picker is the primary control (full width); actions are uniform
         32px icon buttons tucked right. No stretchy text buttons, no dead space. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
      <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Sessions}"
                SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AgentSessionOption">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                         FontSize="11" Opacity="0.55" Margin="10,0,0,0" VerticalAlignment="Center" />
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="重命名" Click="RenameSessionClick" />
                  <MenuItem Header="分叉此会话" Click="ForkSessionClick" />
                </ContextMenu>
              </Grid.ContextMenu>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Width="32" Height="30" Margin="6,0,0,0" Padding="0"
              Content="＋" FontSize="15" ToolTip.Tip="新建会话" Click="NewSession" />
      <Button Grid.Column="2" Width="32" Height="30" Margin="6,0,0,0" Padding="0"
              Content="⇩" FontSize="14" ToolTip.Tip="导出会话转录" Click="ExportTranscript"
              IsEnabled="{Binding HasTranscript}" />
      <Button Grid.Column="3" Width="32" Height="30" Margin="6,0,0,0" Padding="0"
              Content="⚙" FontSize="14" ToolTip.Tip="设置" Click="OpenSettings" />
    </Grid>
    <!-- Model badge: quiet metadata bar spanning the full row, with a live indicator dot. -->
    <Border Grid.Row="1" Padding="9,4" Margin="0,0,0,10"
            Background="{DynamicResource SemiColorFill0}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1" CornerRadius="6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Ellipse Width="6" Height="6" Fill="{DynamicResource SemiColorSuccess}"
                 VerticalAlignment="Center" />
        <TextBlock Text="{Binding Model}" FontSize="11" Opacity="0.78"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Border Padding="11,9"
              Background="{DynamicResource SemiColorFill0}"
              BorderBrush="{DynamicResource SemiColorPrimary}"
              BorderThickness="1" CornerRadius="7"
              IsVisible="{Binding HasActivePage}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="●" FontSize="9" Margin="0,1,9,0"
                     Foreground="{DynamicResource SemiColorPrimary}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="已绑定内置浏览器页面" FontSize="11" Opacity="0.62" />
            <TextBlock Text="{Binding ActivePageLabel}" FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="2" Margin="10,0,0,0" Padding="8,4"
                  Background="{DynamicResource SemiColorFill0}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding ActivePageId}" FontSize="10" Opacity="0.58"
                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
      </Border>
      <Border Padding="11,9"
              Background="{DynamicResource SemiColorFill0}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1" CornerRadius="7"
              IsVisible="{Binding !HasActivePage}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="○" FontSize="13" Margin="0,0,9,0" Opacity="0.48"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="未绑定浏览器页面" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="请先切换到一个内置浏览器标签页，AI 操作将只作用于当前页面。"
                       FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3">
      <Border Padding="24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SemiColorFill0}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1"
              CornerRadius="10"
              IsVisible="{Binding !Messages.Count}">
        <StackPanel Spacing="7" HorizontalAlignment="Center">
          <TextBlock Text="AI 助手" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="描述页面问题，我会结合当前上下文帮你分析。"
                     FontSize="12" Opacity="0.62" TextWrapping="Wrap"
                     TextAlignment="Center" MaxWidth="300" />
        </StackPanel>
      </Border>
      <ScrollViewer Name="PART_TranscriptScroll">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.DataTemplates>
            <!-- Reasoning-model thinking rows: quieter visual weight than prose, with a
                 left accent bar, so long chains-of-thought stay scannable. Must precede
                 the base AiChatLine template (first assignable template wins). -->
            <DataTemplate x:DataType="vm:AiReasoningLine">
              <Border Margin="0,0,0,6" Padding="12,8" BorderThickness="2,1,1,1"
                      CornerRadius="7" Opacity="0.88"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiColorPrimary}">
                <StackPanel Spacing="4">
                  <TextBlock Text="💭 思考过程" FontSize="10.5" FontWeight="SemiBold" Opacity="0.55" />
                  <SelectableTextBlock FontSize="11.5" LineHeight="17" Opacity="0.78"
                                       TextWrapping="Wrap" Text="{Binding Content}" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- Keep the derived tool template before the AiChatLine base template.
                 Avalonia selects the first assignable template, so reversing these renders
                 a tool call as an empty plain message card. -->
            <DataTemplate x:DataType="vm:AiToolCallLine">
              <Border Margin="0,0,0,6"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiColorBorder}"
                      BorderThickness="1" CornerRadius="7">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="10,4,10,2">
                  <Expander.Header>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2" VerticalAlignment="Center">
                      <ProgressBar Width="14" Height="4" IsIndeterminate="True"
                                   IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                      <TextBlock Text="✓" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                 Foreground="#3EB877"
                                 IsVisible="{Binding IsSuccess}" />
                      <TextBlock Text="✗" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SemiColorDanger}"
                                 IsVisible="{Binding IsFailed}" />
                      <TextBlock Grid.Column="1" Text="{Binding ToolName}" Margin="8,0,0,0"
                                 FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Summary}" Margin="8,0,0,0"
                                 FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" Margin="8,0,0,0"
                                 FontSize="10" Opacity="0.45" VerticalAlignment="Center" />
                    </Grid>
                  </Expander.Header>
                  <SelectableTextBlock Text="{Binding Detail}" FontSize="11.5" LineHeight="17"
                                       TextWrapping="Wrap" Margin="2,4,2,8"
                                       FontFamily="Consolas, 'Cascadia Mono', 'Courier New', monospace" />
                </Expander>
              </Border>
            </DataTemplate>
            <!-- Plain conversation turn: user / assistant prose. -->
            <DataTemplate x:DataType="vm:AiChatLine">
              <Border Padding="12,10" Margin="0,0,0,8"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiColorBorder}"
                      BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.62" Text="{Binding RoleLabel}" />
                  <SelectableTextBlock FontSize="13" LineHeight="20"
                                       TextWrapping="Wrap" Text="{Binding Content}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,8,0,0" Spacing="2">
        <Expander Margin="0,0,0,6" Padding="10,6"
                Background="{DynamicResource SemiColorFill0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                CornerRadius="7"
                IsVisible="{Binding HasTodos}">
        <Expander.Header>
          <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.72">
            <Run Text="☑ " /><Run Text="{Binding TodoSummary, Mode=OneWay}" />
          </TextBlock>
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding Todos}" Margin="2,4,2,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Opacity="0.85" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
      <Border Padding="11,9" Margin="0,0,0,6"
              Background="{DynamicResource SemiColorFill0}"
              BorderBrush="{DynamicResource SemiColorPrimary}"
              BorderThickness="1" CornerRadius="7"
              IsVisible="{Binding HasPendingInstruction}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Text="{Binding PendingInstructionHint}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource SemiColorPrimary}" />
          <TextBlock Grid.Row="1" Text="{Binding PendingInstructionSummary}" Margin="0,4,12,0"
                     FontSize="12" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center">
            <Button Content="优先执行" Padding="9,4" Command="{Binding PrioritizePendingInstructionCommand}" />
            <Button Content="取消" Padding="9,4" Command="{Binding CancelPendingInstructionCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Padding="10,8"
              Background="{DynamicResource SemiColorFill0}" CornerRadius="6"
              IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap" Text="{Binding Error}" />
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14">
        <TextBlock FontSize="11" Opacity="0.65"
                   Text="{Binding TokenUsage}"
                   IsVisible="{Binding TokenUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock FontSize="11" Opacity="0.65"
                   Text="{Binding ContextUsage}"
                   IsVisible="{Binding ContextUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBox Name="PART_PromptInput" AcceptsReturn="True" MinHeight="76" MaxHeight="180" Padding="12,10" TextWrapping="Wrap"
               VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"
               Text="{Binding Input, Mode=TwoWay}" PlaceholderText="输入指示；Enter 发送，Ctrl+Enter 换行" />
      <StackPanel Grid.Column="1" Width="72" Margin="8,0,0,0" Spacing="6">
        <Button Content="{Binding SendButtonLabel}" Padding="14,8" HorizontalContentAlignment="Center"
                Command="{Binding SendCommand}" />
        <Button Content="停止" Padding="14,8" HorizontalContentAlignment="Center"
                Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Grid>
    <ProgressBar Grid.Row="5" IsIndeterminate="True" Height="2"
                 VerticalAlignment="Bottom" Margin="12,0,92,1"
                 IsVisible="{Binding IsBusy}" />
  </Grid>
</UserControl>

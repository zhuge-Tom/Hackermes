<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hackermes.AiPanel.ViewModels"
             x:Class="Hackermes.AiPanel.Views.AiChatView"
             x:DataType="vm:AiChatViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="8">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
      <TextBlock VerticalAlignment="Center" Text="模型" Margin="0,0,6,0" />
      <Border Grid.Column="1" Padding="10,7" Background="{DynamicResource SemiColorFill0}" CornerRadius="4">
        <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Border>
      <Button Grid.Column="2" Margin="6,0,0,0" Content="设置" Click="OpenSettings" />
    </Grid>
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiChatLine">
            <Border Padding="8" Margin="0,3" Background="{DynamicResource SemiColorFill0}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Role}" />
                <SelectableTextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Content}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap"
               Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
      <TextBox AcceptsReturn="True" MinHeight="64" MaxHeight="160" TextWrapping="Wrap"
               Text="{Binding Input, Mode=TwoWay}" PlaceholderText="描述你想检查的页面问题…" />
      <StackPanel Grid.Column="1" Margin="6,0,0,0">
        <Button Content="发送" Command="{Binding SendCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="停止" Margin="0,4,0,0" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hookmes.App.ViewModels"
             xmlns:dock="using:Hookmes.Dock.Controls"
             x:Class="Hookmes.App.Views.MainContentView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel LastChildFill="True">

    <!-- 顶栏。阶段 2 拆成独立的 TopBarView,届时接入地址栏、设备模拟、拾取器、录制 -->
    <Border DockPanel.Dock="Top"
            Height="40"
            Padding="8,0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Hookmes"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="4,0,12,0" />
          <Button Content="打开文件夹"
                  Classes="Tertiary"
                  Command="{Binding OpenFolderCommand}" />
          <Button Content="新建标签页"
                  Command="{Binding NewBrowserTabCommand}"
                  ToolTip.Tip="打开一个内置浏览器标签页" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding WorkspaceName}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Opacity="0.6"
                   FontSize="12" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ToggleButton Content="左"
                        IsChecked="{Binding DockLayout.Left.IsVisible, Mode=TwoWay}"
                        ToolTip.Tip="切换左侧面板" />
          <ToggleButton Content="下"
                        IsChecked="{Binding DockLayout.Bottom.IsVisible, Mode=TwoWay}"
                        ToolTip.Tip="切换底部面板" />
          <ToggleButton Content="右"
                        IsChecked="{Binding DockLayout.Right.IsVisible, Mode=TwoWay}"
                        ToolTip.Tip="切换右侧面板" />
          <Button Content="主题"
                  Command="{Binding ToggleThemeCommand}" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- 状态栏。本应用没有 Toast,状态栏就是它的替代 -->
    <Border DockPanel.Dock="Bottom"
            Height="24"
            Padding="10,0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 FontSize="11"
                 Opacity="0.75"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- 五区域。区域是编译期固定的,只有 Tab 动态 -->
    <Grid Name="PART_RegionGrid"
          ColumnDefinitions="240,Auto,*,Auto,300">

      <!-- 左 -->
      <dock:PersistTabControl Name="PART_LeftPanel"
                              Grid.Column="0"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              ItemsSource="{Binding DockLayout.Left.Tabs}"
                              SelectedItem="{Binding DockLayout.Left.SelectedTab, Mode=TwoWay}" />

      <GridSplitter Name="PART_LeftSplitter"
                    Grid.Column="1"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns" />

      <!-- 中 + 下 -->
      <Grid Grid.Column="2" Name="PART_CenterGrid" RowDefinitions="*,Auto,200">

        <dock:PersistTabControl Name="PART_ContentPanel"
                                Grid.Row="0"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                ItemsSource="{Binding DockLayout.Content.Tabs}"
                                SelectedItem="{Binding DockLayout.Content.SelectedTab, Mode=TwoWay}" />

        <GridSplitter Name="PART_BottomSplitter"
                      Grid.Row="1"
                      Height="4"
                      Background="Transparent"
                      ResizeDirection="Rows" />

        <dock:PersistTabControl Name="PART_BottomPanel"
                                Grid.Row="2"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                ItemsSource="{Binding DockLayout.Bottom.Tabs}"
                                SelectedItem="{Binding DockLayout.Bottom.SelectedTab, Mode=TwoWay}" />
      </Grid>

      <GridSplitter Name="PART_RightSplitter"
                    Grid.Column="3"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns" />

      <!-- 右 -->
      <dock:PersistTabControl Name="PART_RightPanel"
                              Grid.Column="4"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              ItemsSource="{Binding DockLayout.Right.Tabs}"
                              SelectedItem="{Binding DockLayout.Right.SelectedTab, Mode=TwoWay}" />

    </Grid>

  </DockPanel>
</UserControl>

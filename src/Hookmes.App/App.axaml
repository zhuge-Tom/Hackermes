<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hookmes.App"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Hookmes.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <semi:UrsaSemiTheme Locale="zh-CN" />
    <semi:DataGridSemiTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Semi.Avalonia/Icons/FillIcons.axaml" />
        <ResourceInclude Source="avares://Semi.Avalonia/Icons/StrokedIcons.axaml" />
        <ResourceInclude Source="avares://Hookmes.Dock/Themes/PersistTabControl.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F5F6F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1E" />
          <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#141416" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <x:Double x:Key="HookmesTabStripHeight">32</x:Double>
    </ResourceDictionary>
  </Application.Resources>
</Application>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hackermes.Inspector.ViewModels"
             x:Class="Hackermes.Inspector.Views.TrafficComparerView"
             x:DataType="vm:TrafficComparerViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="8">
    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Left source" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedLeftSource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TrafficComparerSourceItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding LeftSourceReference}" PlaceholderText="traffic-request:&lt;packet-id&gt;" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Right source" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedRightSource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TrafficComparerSourceItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding RightSourceReference}" PlaceholderText="repeater-response:&lt;draft&gt;:&lt;send&gt;" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,8" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBox Grid.Column="0" Text="{Binding SessionName}" PlaceholderText="Named comparison session" />
      <Button Grid.Column="1" Content="Compare" Command="{Binding CompareCommand}" />
      <Button Grid.Column="2" Content="Save" Command="{Binding CreateSessionCommand}" />
      <Button Grid.Column="3" Content="Rename" Command="{Binding RenameSessionCommand}" />
      <Button Grid.Column="4" Content="Recalculate" Command="{Binding RecalculateSessionCommand}" />
      <Button Grid.Column="5" Content="Delete" Command="{Binding DeleteSessionCommand}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="8">
      <Border Grid.Column="0" BorderThickness="1" CornerRadius="4" Padding="4">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Saved sessions" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
          </Grid>
          <ListBox Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TrafficComparerSessionItem">
                <StackPanel Margin="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" Opacity="0.75" />
                  <TextBlock Text="{Binding UpdatedAt}" FontSize="11" Opacity="0.6" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <TextBox Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas,monospace" Text="{Binding Result}" />
    </Grid>
  </Grid>
</UserControl>

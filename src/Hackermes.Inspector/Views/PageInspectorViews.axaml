<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hackermes.Inspector.ViewModels"
             xmlns:inspection="using:Hackermes.Inspector.Services"
             x:Class="Hackermes.Inspector.Views.DomInspectorView"
             x:DataType="vm:DomInspectorViewModel">
  <UserControl.Styles>
    <Style Selector="SelectableTextBlock.code">
      <Setter Property="FontFamily" Value="Consolas,monospace" />
    </Style>
    <Style Selector="SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" MinHeight="0">
    <Border Grid.Row="0" Padding="8,5" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SemiColorBorder}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Elements" />
        <SelectableTextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0"
                             Text="DOM tree · hover to preview · click to reveal on the page" />
        <Button Grid.Column="2" Content="Refresh" ToolTip.Tip="Reload the DOM after the page structure changes"
                Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>

    <SelectableTextBlock Grid.Row="1" Classes="muted" Margin="8,4" TextWrapping="Wrap" Text="{Binding Status}" />

    <Border Grid.Row="2" Margin="8,0,8,5" Padding="6,4" Background="{DynamicResource SemiColorFill0}"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DomTreeNodeViewModel">
              <SelectableTextBlock Classes="code" Foreground="{DynamicResource SemiColorPrimary}"
                                   Text="{Binding Display}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="2*,5,2*" MinHeight="0">
      <Border Grid.Column="0" Margin="8,0,0,8" BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1" ClipToBounds="True">
        <TreeView x:Name="PART_DomTree" ItemsSource="{Binding RootItems}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:DomTreeNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:DomTreeNodeViewModel" ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="2,1" PointerEntered="OnDomNodePointerEntered">
                <TextBlock Grid.Column="0" Width="14" Foreground="{DynamicResource SemiColorPrimary}"
                           Text="{Binding PageHoverMarker}" />
                <SelectableTextBlock Grid.Column="1" Classes="code" Foreground="#A12BAF" Text="{Binding Display}" />
                <SelectableTextBlock Grid.Column="2" Classes="muted" Margin="8,0,0,0"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                <TextBlock Grid.Column="3" Margin="8,0,4,0" Foreground="{DynamicResource SemiColorText2}"
                           Text="{Binding ChildSummary}" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" Margin="0,0,0,8" Background="{DynamicResource SemiColorBorder}"
                    ResizeDirection="Columns" />

      <Border Grid.Column="2" Margin="0,0,8,8" BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1" ClipToBounds="True" MinWidth="260">
        <Grid RowDefinitions="Auto,*" MinHeight="0">
          <Border Grid.Row="0" Padding="10,7" BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource SemiColorBorder}" Background="{DynamicResource SemiColorFill0}">
            <StackPanel Spacing="3">
              <TextBlock FontWeight="SemiBold" Text="Selected element" />
              <SelectableTextBlock Classes="code" Foreground="#A12BAF" TextWrapping="Wrap"
                                   Text="{Binding SelectedNodeTitle}" />
              <SelectableTextBlock Classes="code muted" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding SelectedNodePath}" />
            </StackPanel>
          </Border>

          <TabControl Grid.Row="1" MinHeight="0">
            <TabItem Header="Styles" ToolTip.Tip="Matched stylesheet rules and editable declarations">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" Spacing="7">
                  <TextBlock FontWeight="SemiBold" Text="Matched CSS rules" />
                  <ComboBox ItemsSource="{Binding MatchedCssRules}" SelectedItem="{Binding SelectedCssRule, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="inspection:DomCssRuleItem">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock FontFamily="Consolas,monospace" Text="{Binding Selector}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource SemiColorText2}"
                                     Text="{Binding Source}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock FontWeight="SemiBold" Text="CSS declarations" />
                  <TextBox AcceptsReturn="True" MinHeight="120" FontFamily="Consolas,monospace"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           TextWrapping="NoWrap" Text="{Binding EditableCss, Mode=TwoWay}" />
                  <SelectableTextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="Edits apply to the selected inline style or matched stylesheet rule." />
                  <Button HorizontalAlignment="Left" Content="Apply CSS" Command="{Binding ApplyCssCommand}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Computed" ToolTip.Tip="Computed values used by the selected element">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="10" ItemsSource="{Binding SelectedComputedStyles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inspection:DomPropertyItem">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                        <SelectableTextBlock Classes="code" MinWidth="130" Foreground="{DynamicResource SemiColorPrimary}"
                                             Text="{Binding Name}" />
                        <SelectableTextBlock Grid.Column="1" Classes="code" Margin="10,0,0,0"
                                             TextWrapping="Wrap" Text="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Attributes" ToolTip.Tip="HTML attributes on the selected element">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="10" ItemsSource="{Binding SelectedAttributes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inspection:DomPropertyItem">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                        <SelectableTextBlock Classes="code" MinWidth="110" Foreground="{DynamicResource SemiColorPrimary}"
                                             Text="{Binding Name}" />
                        <SelectableTextBlock Grid.Column="1" Classes="code" Margin="10,0,0,0"
                                             TextWrapping="Wrap" Text="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Resource" ToolTip.Tip="src or href linked by the selected element">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Text="Linked src / href" />
                  <SelectableTextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Shows the absolute resource URL referenced by this element. Elements without src or href have no linked resource." />
                  <TextBox IsReadOnly="True" AcceptsReturn="True" MinHeight="72" FontFamily="Consolas,monospace"
                           TextWrapping="Wrap" Text="{Binding SelectedResourceUrl}" />
                  <Button HorizontalAlignment="Left" Content="Open resource in browser"
                          Command="{Binding OpenSelectedResourceCommand}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UsesAvalonia>true</UsesAvalonia>
    <!-- COM vtable 直调需要函数指针 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    刻意不引用 Microsoft.Web.WebView2。
    本层完全走 vtable 直调,用不到它的任何托管类型;而该包会拖进 WPF 的
    Microsoft.Web.WebView2.Wpf.dll,与 net10.0 的 WindowsBase 产生版本冲突(MSB3277)。
    需要的 IID 与 vtable 槽位已按 SDK 头文件硬编码在 ComInterop 下,并注明了核对方式。
    WebView2 运行时本身由 Avalonia.Controls.WebView 在宿主侧引入。
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hackermes.Base\Hackermes.Base.csproj" />
    <ProjectReference Include="..\Hackermes.Platform\Hackermes.Platform.csproj" />
  </ItemGroup>

</Project>

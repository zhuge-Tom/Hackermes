<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hookmes.Inspector.ViewModels"
             x:Class="Hookmes.Inspector.Views.TrafficWorkbenchView"
             x:DataType="vm:TrafficWorkbenchViewModel">
  <Grid RowDefinitions="Auto,Auto,2*,3*">
    <Border Grid.Row="0" Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SemiColorBorder}">
      <Grid ColumnDefinitions="Auto,180,80,70,90,Auto,*,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Content="Refresh" Command="{Binding ReloadCommand}" />
        <TextBox Grid.Column="1" Margin="8,0" Watermark="Filter URL / method / status" Text="{Binding FilterText, Mode=TwoWay}" />
        <TextBox Grid.Column="2" Margin="0,0,6,0" PlaceholderText="Method" Text="{Binding MethodFilter}" />
        <TextBox Grid.Column="3" Margin="0,0,6,0" PlaceholderText="Status" Text="{Binding StatusFilter}" />
        <TextBox Grid.Column="4" Margin="0,0,6,0" PlaceholderText="Type" Text="{Binding ResourceTypeFilter}" />
        <CheckBox Grid.Column="5" Content="Held" VerticalAlignment="Center" IsChecked="{Binding OnlyIntercepted, Mode=TwoWay}" />
        <TextBlock Grid.Column="6" Margin="12,0" VerticalAlignment="Center" Opacity="0.65" Text="{Binding Summary}" />
        <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="Requests" FontWeight="SemiBold" />
        <ToggleSwitch Grid.Column="8" Margin="8,0,0,0" IsChecked="{Binding IsInterceptEnabled, Mode=TwoWay}" />
        <TextBlock Grid.Column="9" Margin="12,0,0,0" VerticalAlignment="Center" Text="Responses" FontWeight="SemiBold" />
        <ToggleSwitch Grid.Column="10" Margin="8,0,0,0" IsChecked="{Binding IsResponseInterceptEnabled, Mode=TwoWay}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SemiColorBorder}">
      <Grid ColumnDefinitions="Auto,260,180,Auto,Auto,*">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Archive" FontWeight="SemiBold" />
        <TextBox Grid.Column="1" Margin="8,0" PlaceholderText="Path ending in .har or .json" Text="{Binding ArchivePath}" />
        <TextBox Grid.Column="2" Margin="0,0,8,0" PlaceholderText="Optional URL/method filter" Text="{Binding ArchiveFilter}" />
        <Button Grid.Column="3" Content="Export" Command="{Binding ExportArchiveCommand}" />
        <Button Grid.Column="4" Margin="6,0,0,0" Content="Import" Command="{Binding ImportArchiveCommand}" />
        <TextBlock Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                   Text="Hookmes JSON / HAR 1.2; binary bodies remain lossless" />
      </Grid>
    </Border>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected, Mode=TwoWay}"
              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" FontSize="11">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Width="92" Binding="{Binding TimeText}" x:DataType="vm:TrafficExchange" />
        <DataGridTextColumn Header="Method" Width="70" Binding="{Binding Method}" x:DataType="vm:TrafficExchange" />
        <DataGridTextColumn Header="Host" Width="160" Binding="{Binding Host}" x:DataType="vm:TrafficExchange" />
        <DataGridTextColumn Header="Path" Width="*" Binding="{Binding Path}" x:DataType="vm:TrafficExchange" />
        <DataGridTextColumn Header="Status" Width="70" Binding="{Binding StatusText}" x:DataType="vm:TrafficExchange" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,*">
      <TabControl Grid.Row="0" Grid.Column="0" Margin="0,4,2,0">
        <TabItem Header="Request editor"><TextBox AcceptsReturn="True" FontFamily="Consolas,monospace" FontSize="12" Text="{Binding RequestEditor, Mode=TwoWay}" /></TabItem>
        <TabItem Header="Request pretty"><TextBox IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,monospace" FontSize="12" Text="{Binding FormattedRequest}" /></TabItem>
        <TabItem Header="Binary editor">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="6">
            <Border Grid.Row="0" Padding="7,5" Background="{DynamicResource SemiColorFill0}">
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BinaryBodySummary}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="Refresh info" Command="{Binding RefreshBinaryBodyInfoCommand}" />
              </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="100,100,100,100,100,Auto,Auto,Auto,Auto,*">
              <TextBox Grid.Column="0" Margin="0,0,4,4" PlaceholderText="request/response" Text="{Binding BinarySide}" />
              <TextBox Grid.Column="1" Margin="0,0,4,4" PlaceholderText="replace/insert/delete" Text="{Binding BinaryKind}" />
              <TextBox Grid.Column="2" Margin="0,0,4,4" PlaceholderText="Offset / jump" Text="{Binding BinaryOffset}" />
              <TextBox Grid.Column="3" Margin="0,0,4,4" PlaceholderText="Chunk count" Text="{Binding BinaryCount}" />
              <TextBox Grid.Column="4" Margin="0,0,4,4" PlaceholderText="hex/base64" Text="{Binding BinaryEncoding}" />
              <Button Grid.Column="5" Margin="0,0,4,0" Content="Previous" Command="{Binding PreviousBinaryChunkCommand}" />
              <Button Grid.Column="6" Margin="0,0,4,0" Content="Load / Jump" Command="{Binding LoadBinaryChunkCommand}" />
              <Button Grid.Column="7" Margin="0,0,4,0" Content="Next" Command="{Binding NextBinaryChunkCommand}" />
              <Button Grid.Column="8" Content="Apply edit" Command="{Binding ApplyBinaryEditCommand}" />
            </Grid>
            <Grid Grid.Row="2" Margin="0,2,0,6" ColumnDefinitions="*,180">
              <TextBlock VerticalAlignment="Center" Opacity="0.72" Text="{Binding BinaryRangeStatus}" />
              <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="{Binding BinaryProgress}" />
            </Grid>
            <TextBox Grid.Row="3" AcceptsReturn="True" FontFamily="Consolas,monospace"
                     PlaceholderText="Encoded hex or base64 data (empty for delete)" Text="{Binding BinaryData}" />
            <Grid Grid.Row="4" Margin="0,6,0,0" ColumnDefinitions="*,Auto,Auto">
              <SelectableTextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BinaryDraftStatus}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="Refresh draft" Command="{Binding RefreshBinaryDraftCommand}" />
              <Button Grid.Column="2" Margin="6,0,0,0" Content="Discard draft" Command="{Binding DiscardBinaryDraftCommand}" />
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Parameters">
          <Grid RowDefinitions="Auto,*,Auto" Margin="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock VerticalAlignment="Center" Text="Side" />
              <TextBox Width="100" PlaceholderText="request/response" Text="{Binding ParameterSide}" />
              <TextBlock VerticalAlignment="Center" Opacity="0.65" Text="Query, form and top-level JSON parameters" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Location" Width="90" Binding="{Binding Location}" x:DataType="vm:TrafficParameterItem" />
                <DataGridTextColumn Header="Name" Width="160" Binding="{Binding Name}" x:DataType="vm:TrafficParameterItem" />
                <DataGridTextColumn Header="#" Width="45" Binding="{Binding Occurrence}" x:DataType="vm:TrafficParameterItem" />
                <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" x:DataType="vm:TrafficParameterItem" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="New parameter value" Text="{Binding ParameterValue}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="Apply to editor" Command="{Binding ApplyParameterCommand}" />
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Annotation">
          <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*" Margin="6">
            <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,12,6" Content="Starred" IsChecked="{Binding AnnotationStarred}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Watermark="Status: Unreviewed / InReview / Resolved / Ignored" Text="{Binding AnnotationStatus}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Tags" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Watermark="comma,separated,tags" Text="{Binding AnnotationTags}" />
            <TextBox Grid.Row="2" Grid.ColumnSpan="2" AcceptsReturn="True" Watermark="Analyst note" Text="{Binding AnnotationNote}" />
            <Button Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,6,0,0"
                    Content="Save annotation" Command="{Binding SaveAnnotationCommand}" />
          </Grid>
        </TabItem>
      </TabControl>
      <TabControl Grid.Row="0" Grid.Column="1" Margin="2,4,0,0">
        <TabItem Header="Response editor"><TextBox AcceptsReturn="True" FontFamily="Consolas,monospace" FontSize="12" Text="{Binding ResponseEditor, Mode=TwoWay}" /></TabItem>
        <TabItem Header="Response pretty"><TextBox IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,monospace" FontSize="12" Text="{Binding FormattedResponse}" /></TabItem>
        <TabItem Header="Findings">
          <Grid RowDefinitions="Auto,*,Auto" Margin="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock VerticalAlignment="Center" Text="Analyze side" />
              <TextBox Width="110" PlaceholderText="request/response" Text="{Binding AnalysisSide}" />
              <Button Content="Analyze" Command="{Binding AnalyzeCommand}" />
            </StackPanel>
            <DataGrid Grid.Row="1" Margin="0,6" ItemsSource="{Binding Findings}"
                      SelectedItem="{Binding SelectedFinding, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Width="75" Binding="{Binding Severity}" x:DataType="vm:TrafficFindingItem" />
                <DataGridTextColumn Header="Code" Width="150" Binding="{Binding Code}" x:DataType="vm:TrafficFindingItem" />
                <DataGridTextColumn Header="Side" Width="70" Binding="{Binding Side}" x:DataType="vm:TrafficFindingItem" />
                <DataGridTextColumn Header="Location" Width="150" Binding="{Binding Location}" x:DataType="vm:TrafficFindingItem" />
                <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" x:DataType="vm:TrafficFindingItem" />
              </DataGrid.Columns>
            </DataGrid>
            <SelectableTextBlock Grid.Row="2" TextWrapping="Wrap" Text="{Binding FindingTarget}" />
          </Grid>
        </TabItem>
        <TabItem Header="Audit">
          <Grid RowDefinitions="Auto,*" Margin="6">
            <Button HorizontalAlignment="Left" Content="Refresh selected packet audit" Command="{Binding RefreshAuditCommand}" />
            <DataGrid Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Width="135" Binding="{Binding Timestamp}" x:DataType="vm:TrafficAuditItem" />
                <DataGridTextColumn Header="Entry" Width="90" Binding="{Binding EntryPoint}" x:DataType="vm:TrafficAuditItem" />
                <DataGridTextColumn Header="Operation" Width="80" Binding="{Binding Operation}" x:DataType="vm:TrafficAuditItem" />
                <DataGridTextColumn Header="Side" Width="70" Binding="{Binding Side}" x:DataType="vm:TrafficAuditItem" />
                <DataGridTextColumn Header="Before" Width="*" Binding="{Binding Before}" x:DataType="vm:TrafficAuditItem" />
                <DataGridTextColumn Header="After" Width="*" Binding="{Binding After}" x:DataType="vm:TrafficAuditItem" />
                <DataGridTextColumn Header="Result" Width="80" Binding="{Binding Result}" x:DataType="vm:TrafficAuditItem" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="History storage">
          <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*,Auto,*" Margin="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" VerticalAlignment="Center" Text="Max entries" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,6" Text="{Binding HistoryMaxEntries}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,6,6" VerticalAlignment="Center" Text="Max bytes" />
            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" Text="{Binding HistoryMaxBytes}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,6" VerticalAlignment="Center" Text="Retention days" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,6" Text="{Binding HistoryRetentionDays}" />
            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Automatic pruning" IsChecked="{Binding HistoryAutoPrune}" />
            <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="6">
              <Button Content="Refresh stats" Command="{Binding RefreshHistoryCommand}" />
              <Button Content="Preview cleanup" Command="{Binding PreviewHistoryCleanupCommand}" />
              <Button Content="Save and apply policy" Command="{Binding SaveHistoryPolicyCommand}" />
              <Button Content="Run cleanup" Command="{Binding CleanupTrafficHistoryCommand}" />
              <CheckBox Margin="12,0,0,0" Content="Confirm clear all" IsChecked="{Binding ConfirmHistoryClear}" />
              <Button Content="Clear all history" Command="{Binding ClearTrafficHistoryCommand}" />
            </StackPanel>
            <SelectableTextBlock Grid.Row="3" Grid.ColumnSpan="4" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding HistoryStatus}" />
          </Grid>
        </TabItem>
      </TabControl>
      <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="8,5" Background="{DynamicResource SemiColorFill0}">
        <SelectableTextBlock Text="{Binding Analysis}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8,6">
        <Button Content="Analyze" Command="{Binding AnalyzeCommand}" />
        <Button Content="Replay" Command="{Binding ReplayCommand}" />
        <Button Content="Send to Repeater" Command="{Binding SendToRepeaterCommand}" />
        <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
        <Button Content="Next" Command="{Binding NextPageCommand}" />
        <Border Width="1" Margin="5,0" Background="{DynamicResource SemiColorBorder}" />
        <Button Content="Continue" Command="{Binding ContinueCommand}" />
        <Button Content="Drop" Command="{Binding DropCommand}" />
        <Button Content="Fulfill edited response" Command="{Binding FulfillCommand}" />
        <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="Working…" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

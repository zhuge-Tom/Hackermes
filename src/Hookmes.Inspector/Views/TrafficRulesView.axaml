<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hookmes.Inspector.ViewModels"
             x:Class="Hookmes.Inspector.Views.TrafficRulesView"
             x:DataType="vm:TrafficRulesViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" Margin="8" ColumnDefinitions="130,*,90,100,100,Auto">
      <TextBox Grid.Column="0" Margin="0,0,6,0" PlaceholderText="Rule id" Text="{Binding Id}" />
      <TextBox Grid.Column="1" Margin="0,0,6,0" PlaceholderText="URL glob, e.g. *://*/api/*" Text="{Binding UrlPattern}" />
      <TextBox Grid.Column="2" Margin="0,0,6,0" PlaceholderText="Method or *" Text="{Binding Method}" />
      <TextBox Grid.Column="3" Margin="0,0,6,0" PlaceholderText="request/response" Text="{Binding Stage}" />
      <TextBox Grid.Column="4" Margin="0,0,6,0" PlaceholderText="pause/drop" Text="{Binding Behavior}" />
      <Button Grid.Column="5" Content="Add rule" Command="{Binding AddCommand}" />
    </Grid>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="On" Width="50" Binding="{Binding Enabled}" x:DataType="vm:TrafficRuleItem" />
        <DataGridTextColumn Header="Id" Width="140" Binding="{Binding Id}" x:DataType="vm:TrafficRuleItem" />
        <DataGridTextColumn Header="URL pattern" Width="*" Binding="{Binding UrlPattern}" x:DataType="vm:TrafficRuleItem" />
        <DataGridTextColumn Header="Method" Width="80" Binding="{Binding Method}" x:DataType="vm:TrafficRuleItem" />
        <DataGridTextColumn Header="Stage" Width="90" Binding="{Binding Stage}" x:DataType="vm:TrafficRuleItem" />
        <DataGridTextColumn Header="Behavior" Width="90" Binding="{Binding Behavior}" x:DataType="vm:TrafficRuleItem" />
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="8,6" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
      <Button Grid.Column="0" Content="Enable / disable" Command="{Binding ToggleCommand}" />
      <Button Grid.Column="1" Margin="6,0,0,0" Content="Remove" Command="{Binding RemoveCommand}" />
      <Button Grid.Column="2" Margin="6,0,0,0" Content="Move up" Command="{Binding MoveUpCommand}" />
      <Button Grid.Column="3" Margin="6,0,0,0" Content="Move down" Command="{Binding MoveDownCommand}" />
      <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" Opacity="0.7" />
    </Grid>
  </Grid>
</UserControl>

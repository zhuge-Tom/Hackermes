    <!-- Avalonia.Controls.WebView 会拖进 WebView2 的 WPF 程序集,与 net10.0 的 WindowsBase 冲突 -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hookmes.Base\Hookmes.Base.csproj" />
    <ProjectReference Include="..\Hookmes.Platform\Hookmes.Platform.csproj" />
    <ProjectReference Include="..\Hookmes.Cdp\Hookmes.Cdp.csproj" />
    <ProjectReference Include="..\Hookmes.Dock\Hookmes.Dock.csproj" />
    <ProjectReference Include="..\Hookmes.PageAgent\Hookmes.PageAgent.csproj" />
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hookmes.Browser.ViewModels"
             x:Class="Hookmes.Browser.Views.BrowserTabView"
             x:DataType="vm:BrowserTabViewModel">

  <DockPanel LastChildFill="True">

    <!-- 地址栏 -->
    <Border DockPanel.Dock="Top"
            Height="36"
            Padding="6,0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <Button Grid.Column="0" Content="←" Width="28" Padding="0"
                Background="Transparent" BorderThickness="0"
                Command="{Binding BackCommand}" ToolTip.Tip="后退" />
        <Button Grid.Column="1" Content="→" Width="28" Padding="0"
                Background="Transparent" BorderThickness="0"
                Command="{Binding ForwardCommand}" ToolTip.Tip="前进" />
        <Button Grid.Column="2" Content="⟳" Width="28" Padding="0"
                Background="Transparent" BorderThickness="0"
                Command="{Binding ReloadCommand}" ToolTip.Tip="刷新" />

        <TextBox Grid.Column="3"
                 Margin="6,0"
                 VerticalAlignment="Center"
                 Watermark="输入网址或搜索内容"
                 Text="{Binding AddressText, Mode=TwoWay}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding NavigateCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <!-- CDP 通道状态。绿点表示会话已建立,这是本阶段最重要的可见信号 -->
        <Panel Grid.Column="4"
               Width="8" Height="8"
               Margin="6,0"
               VerticalAlignment="Center"
               ToolTip.Tip="CDP 通道状态">
          <Border CornerRadius="4" Background="#4CAF50" IsVisible="{Binding IsCdpReady}" />
          <Border CornerRadius="4" Background="#757575" IsVisible="{Binding !IsCdpReady}" />
        </Panel>

        <Button Grid.Column="5" Content="CDP 自检" Padding="8,2"
                Command="{Binding SelfTestCommand}"
                ToolTip.Tip="通过 Runtime.evaluate 验证 CDP 请求-响应通道" />
      </Grid>
    </Border>

    <!-- 状态条。左侧是实时状态,右侧是自检结果与事件计数 -->
    <Border DockPanel.Dock="Bottom"
            MinHeight="20"
            Padding="8,2"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Opacity="0.7"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Column="1"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="#4CAF50"
                   Text="{Binding SelfTestResult}"
                   IsVisible="{Binding SelfTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="700" />
      </Grid>
    </Border>

    <!-- WebView 宿主。NativeWebView 由 code-behind 创建并加入,不在 XAML 里声明 -->
    <Panel Name="PART_WebViewHost" Background="#FFFFFF" />

  </DockPanel>
</UserControl>

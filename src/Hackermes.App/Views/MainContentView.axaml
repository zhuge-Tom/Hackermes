<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hackermes.App.ViewModels"
             xmlns:dock="using:Hackermes.Dock.Controls"
             x:Class="Hackermes.App.Views.MainContentView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel LastChildFill="True">

    <!-- 顶栏 -->
    <Border DockPanel.Dock="Top"
            Height="42"
            Padding="8,0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- 左:标识与主要操作 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="brand" Text="Hackermes" />
          <Border Classes="toolbarSeparator" />

          <Button Classes="toolbar" Command="{Binding OpenFolderCommand}" ToolTip.Tip="打开工作区目录">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="15" Height="15" Data="{StaticResource IconFolder}" />
              <TextBlock Text="打开" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="toolbar" Command="{Binding NewBrowserTabCommand}" ToolTip.Tip="新建浏览器标签页">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource IconPlus}" />
              <TextBlock Text="新标签页" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 中:当前工作区 -->
        <TextBlock Grid.Column="1"
                   Text="{Binding WorkspaceName}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Opacity="0.5"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis" />

        <!-- 右:布局与外观 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
          <Button Classes="toolbar iconOnly panelToggle"
                  Classes.active="{Binding DockLayout.Left.IsVisible}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="Left"
                  ToolTip.Tip="左侧面板">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconPanelLeft}" />
          </Button>

          <Button Classes="toolbar iconOnly panelToggle"
                  Classes.active="{Binding DockLayout.Bottom.IsVisible}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="Bottom"
                  ToolTip.Tip="底部面板">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconPanelBottom}" />
          </Button>

          <Button Classes="toolbar iconOnly panelToggle"
                  Classes.active="{Binding DockLayout.Right.IsVisible}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="Right"
                  ToolTip.Tip="右侧面板">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconPanelRight}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="toolbar iconOnly"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="切换明暗主题">
            <Grid Width="17" Height="17">
              <PathIcon Width="17" Height="17" Data="{StaticResource IconThemeSun}"
                        IsVisible="{Binding !IsDarkMode}" />
              <PathIcon Width="17" Height="17" Data="{StaticResource IconThemeMoon}"
                        IsVisible="{Binding IsDarkMode}" />
            </Grid>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- 状态栏。本应用没有 Toast,状态栏就是它的替代 -->
    <Border DockPanel.Dock="Bottom"
            Height="24"
            Padding="10,0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 FontSize="11"
                 Opacity="0.75"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- 五区域。区域是编译期固定的,只有 Tab 动态 -->
    <Grid Name="PART_RegionGrid"
          ColumnDefinitions="240,Auto,*,Auto,300">

      <!-- 左 -->
      <dock:PersistTabControl Name="PART_LeftPanel"
                              Grid.Column="0"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              ItemsSource="{Binding DockLayout.Left.Tabs}"
                              SelectedItem="{Binding DockLayout.Left.SelectedTab, Mode=TwoWay}">
        <dock:PersistTabControl.TabStripRightContent>
          <Button Width="28" Height="28" Margin="0,0,4,0" Padding="5"
                  Background="Transparent" BorderThickness="0"
                  Command="{Binding DockLayout.Left.SelectedTab.HeaderActionCommand}"
                  IsVisible="{Binding DockLayout.Left.SelectedTab.HeaderActionCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding DockLayout.Left.SelectedTab.HeaderActionToolTip}">
            <PathIcon Width="16" Height="16"
                      Data="M19.14,12.94 C19.18,12.64 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.27,8.87 L19.35,5.55 C19.23,5.33 18.96,5.26 18.74,5.35 L16.35,6.31 C15.85,5.92 15.3,5.59 14.7,5.35 L14.34,2.81 C14.3,2.57 14.1,2.4 13.85,2.4 H10.01 C9.76,2.4 9.56,2.57 9.53,2.81 L9.17,5.35 C8.57,5.59 8.02,5.93 7.52,6.31 L5.13,5.35 C4.91,5.27 4.64,5.33 4.52,5.55 L2.6,8.87 C2.47,9.09 2.53,9.34 2.72,9.48 L4.75,11.06 C4.7,11.36 4.66,11.69 4.66,12 C4.66,12.31 4.68,12.64 4.73,12.94 L2.7,14.52 C2.52,14.66 2.47,14.93 2.59,15.13 L4.51,18.45 C4.63,18.67 4.9,18.74 5.12,18.65 L7.51,17.69 C8.01,18.08 8.56,18.41 9.16,18.65 L9.52,21.19 C9.56,21.43 9.76,21.6 10,21.6 H13.84 C14.09,21.6 14.29,21.43 14.32,21.19 L14.68,18.65 C15.28,18.41 15.83,18.07 16.33,17.69 L18.72,18.65 C18.94,18.73 19.21,18.67 19.33,18.45 L21.25,15.13 C21.37,14.91 21.32,14.66 21.13,14.52 L19.14,12.94 M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6" />
          </Button>
        </dock:PersistTabControl.TabStripRightContent>
      </dock:PersistTabControl>

      <GridSplitter Name="PART_LeftSplitter"
                    Grid.Column="1"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns" />

      <!-- 中 + 下 -->
      <Grid Grid.Column="2" Name="PART_CenterGrid" RowDefinitions="*,Auto,200">

        <dock:PersistTabControl Name="PART_ContentPanel"
                                Grid.Row="0"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                ItemsSource="{Binding DockLayout.Content.Tabs}"
                                SelectedItem="{Binding DockLayout.Content.SelectedTab, Mode=TwoWay}" />

        <GridSplitter Name="PART_BottomSplitter"
                      Grid.Row="1"
                      Height="4"
                      Background="Transparent"
                      ResizeDirection="Rows" />

        <dock:PersistTabControl Name="PART_BottomPanel"
                                Grid.Row="2"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                ItemsSource="{Binding DockLayout.Bottom.Tabs}"
                                SelectedItem="{Binding DockLayout.Bottom.SelectedTab, Mode=TwoWay}" />
      </Grid>

      <GridSplitter Name="PART_RightSplitter"
                    Grid.Column="3"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns" />

      <!-- 右 -->
      <dock:PersistTabControl Name="PART_RightPanel"
                              Grid.Column="4"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              ItemsSource="{Binding DockLayout.Right.Tabs}"
                              SelectedItem="{Binding DockLayout.Right.SelectedTab, Mode=TwoWay}" />

    </Grid>

  </DockPanel>
</UserControl>

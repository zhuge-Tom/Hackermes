<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hackermes.App"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Hackermes.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <semi:UrsaSemiTheme Locale="zh-CN" />
    <semi:DataGridSemiTheme />
    <StyleInclude Source="avares://Hackermes.App/Styles/TopBar.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Semi.Avalonia/Icons/FillIcons.axaml" />
        <ResourceInclude Source="avares://Semi.Avalonia/Icons/StrokedIcons.axaml" />
        <ResourceInclude Source="avares://Hackermes.App/Themes/PersistTabControl.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F5F6F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1E" />
          <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#141416" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <x:Double x:Key="HackermesTabStripHeight">32</x:Double>

      <!--
        自绘图标。不依赖主题库的图标名 —— 那些 key 在大版本间改过,
        缺失时是静默失败(图标位置一片空白),排查成本高。
        面板图标用 EvenOdd 填充规则:外框描边 + 内部区块实心,
        三个矩形叠加,奇数层填充、偶数层挖空。
      -->
      <StreamGeometry x:Key="IconFolder">M1,4 L7,4 L9,6 L19,6 L19,15 L1,15 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M9,3 L11,3 L11,9 L17,9 L17,11 L11,11 L11,17 L9,17 L9,11 L3,11 L3,9 L9,9 Z</StreamGeometry>
      <!-- F0 = EvenOdd 填充规则,三层矩形叠加才能得到"空心框 + 局部实心" -->
      <StreamGeometry x:Key="IconPanelLeft">F0 M1,3 L19,3 L19,16 L1,16 Z M2.2,4.2 L17.8,4.2 L17.8,14.8 L2.2,14.8 Z M2.2,4.2 L7.5,4.2 L7.5,14.8 L2.2,14.8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPanelBottom">F0 M1,3 L19,3 L19,16 L1,16 Z M2.2,4.2 L17.8,4.2 L17.8,14.8 L2.2,14.8 Z M2.2,10.5 L17.8,10.5 L17.8,14.8 L2.2,14.8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPanelRight">F0 M1,3 L19,3 L19,16 L1,16 Z M2.2,4.2 L17.8,4.2 L17.8,14.8 L2.2,14.8 Z M12.5,4.2 L17.8,4.2 L17.8,14.8 L12.5,14.8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconThemeSun">M8,1 L12,1 L12,4 L8,4 Z M8,16 L12,16 L12,19 L8,19 Z M1,8 L4,8 L4,12 L1,12 Z M16,8 L19,8 L19,12 L16,12 Z M3.1,3.1 L5.9,3.1 L7.1,4.3 L4.3,7.1 L3.1,5.9 Z M14.1,12.9 L16.9,15.7 L16.9,16.9 L15.7,16.9 L12.9,14.1 Z M15.7,3.1 L16.9,3.1 L16.9,4.3 L14.1,7.1 L12.9,5.9 Z M3.1,15.7 L5.9,12.9 L7.1,14.1 L4.3,16.9 L3.1,16.9 Z M10,5.5 A4.5,4.5 0 1,0 10,14.5 A4.5,4.5 0 1,0 10,5.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconThemeMoon">F0 M14.7,2.2 A8,8 0 1,0 17.8,14.7 A6.4,6.4 0 1,1 14.7,2.2 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>
</Application>
